# =============================================================================
# MONTOIT - Variables d'environnement
# =============================================================================
# Copier ce fichier en .env.development, .env.staging ou .env.production
# et remplacer les valeurs par vos propres clés API

# =============================================================================
# SUPABASE
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL pour les redirections d'authentification
SITE_URL=http://localhost:8080
VITE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Studio (optionnel)
SUPABASE_STUDIO_URL=http://127.0.0.1:54323

# =============================================================================
# SERVICES EXTERNES
# =============================================================================

# Gateway API Azure (SMS)
AZURE_SMS_URL=https://api-gateway.example.com
AZURE_SMS_USERNAME=your-username
AZURE_SMS_PASSWORD=your-password
AZURE_SMS_FROM=MONTOIT

# Mapbox (pour cartes avancées, OpenStreetMap utilisé par défaut)
VITE_MAPBOX_PUBLIC_TOKEN=your-mapbox-token

# Web Push (clé VAPID publique en Base64)
VITE_PUBLIC_PUSH_VAPID_KEY=your-base64-vapid-key

# Azure OpenAI (Chatbot, IA)
VITE_AZURE_OPENAI_API_KEY=your-azure-openai-key
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
VITE_AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
VITE_AZURE_OPENAI_API_VERSION=2024-10-21

# Gemini API (Backup AI provider)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# NeoFace (Vérification faciale)
NEOFACE_BEARER_TOKEN=your-neoface-token

# =============================================================================
# SERVICES DE VÉRIFICATION
# =============================================================================

# ONECI - Vérification d'identité nationale (Côte d'Ivoire)
VITE_ONECI_API_URL=https://api-rnpp.verif.ci
VITE_ONECI_API_KEY=your-oneci-api-key
VITE_ONECI_SECRET_KEY=your-oneci-secret

# CryptoNeo - Signatures électroniques certifiées
VITE_CRYPTONEO_BASE_URL=https://cryptoneoplatforms.com
VITE_CRYPTONEO_APP_KEY=your-cryptoneo-app-key
VITE_CRYPTONEO_APP_SECRET=your-cryptoneo-app-secret

# =============================================================================
# PAIEMENTS
# =============================================================================

# InTouch - Mobile Money (Orange, MTN, Wave, Moov)
VITE_INTOUCH_BASE_URL=https://apidist.gutouch.net/apidist/sec
VITE_INTOUCH_API_URL=https://apidist.gutouch.net/apidist/sec
VITE_INTOUCH_USERNAME=your-username
VITE_INTOUCH_PASSWORD=your-password
VITE_INTOUCH_PARTNER_ID=your-partner-id
VITE_INTOUCH_LOGIN_API=your-login
VITE_INTOUCH_PASSWORD_API=your-password-api

# =============================================================================
# CONFIGURATION DE L'APPLICATION
# =============================================================================

# Origines autorisées pour CORS (séparer par des virgules)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Environnement: development | staging | production
VITE_APP_ENV=development

# Niveau de logging: debug | info | warn | error
VITE_LOG_LEVEL=debug

# Features expérimentales
VITE_ENABLE_EXPERIMENTAL_FEATURES=true

# =============================================================================
# ANALYTICS & MONITORING (Optionnel)
# =============================================================================
VITE_ENABLE_ANALYTICS=false
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# =============================================================================
# CI/CD & SECRETS GitHub (ne pas commettre)
# =============================================================================
# Ces variables doivent être configurées dans GitHub Secrets:
# - CODECOV_TOKEN: Token pour Codecov (rapports de couverture)
# - STAGING_URL: URL de l'environnement staging
# - PRODUCTION_URL: URL de l'environnement production
# - GH_TOKEN: GitHub token pour les releases automatiques
