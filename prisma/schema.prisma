// Mon Toit — Prisma Schema
// Rental property platform for ANSUT

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  LOCATAIRE
  PROPRIETAIRE
  AGENCE
  ADMIN
  TIERS_CONFIANCE
}

enum OTPType {
  LOGIN
  EMAIL_VERIFY
  PASSWORD_RESET
  BAIL_SIGNATURE
}

enum PropertyType {
  APPARTEMENT
  MAISON
  STUDIO
  DUPLEX
  PENTHOUSE
  VILLA
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
  RENTED
}

enum RentalStatus {
  disponible
  loue
  reserve
}

enum RentalFileStatus {
  DRAFT
  SUBMITTED
  TC_REVIEW
  VALIDATED
  REJECTED
  EXPIRED
}

enum EmploymentType {
  CDI
  CDD
  FREELANCE
  RETIRED
  OTHER
}

enum TenantCategory {
  SALARIE
  ENTREPRENEUR
  ETUDIANT
}

enum DocumentType {
  ID_CARD
  PASSPORT
  PAY_SLIP
  EMPLOYMENT_CONTRACT
  WORK_CERTIFICATE
  BANK_STATEMENT
  GUARANTOR_ID
  GUARANTOR_INCOME_PROOF
  PROOF_OF_ADDRESS
  PARENT_ADDRESS_PROOF
  RCCM_REGISTRATION
  TAX_DECLARATION
  SCHOOL_CERTIFICATE
  SCHOLARSHIP_CERTIFICATE
  PROPERTY_TITLE
  UTILITY_BILL
  BANK_ACCOUNT_DETAILS
  OTHER
}

enum DocumentStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum OwnershipDocType {
  TITRE_FONCIER
  ACTE_NOTARIE
  ATTESTATION_PROPRIETE
  RCCM
  AGREMENT
}

enum VisitType {
  PHYSICAL
  VIRTUAL
}

enum VisitRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_PROPOSED
  COMPLETED
  CANCELLED
}

enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  TERMINATED
  EXPIRED
}

enum DisputeType {
  UNPAID_RENT
  PROPERTY_DAMAGE
  HARASSMENT
  FRAUD
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ValidationSLAEntityType {
  RENTAL_FILE
  OWNER_PROFILE
  AGENCY
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  PARTIAL
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  MESSAGE
  DOSSIER_UPDATE
  VISIT_REMINDER
  PAYMENT_ALERT
  PROMOTION
  SYSTEM
  MISSION_ASSIGNED
  MISSION_COMPLETED
  DISPUTE_ASSIGNED
  PROPERTY_VERIFICATION
  VERIFICATION_RESULT
}

enum InventoryType {
  INVENTORY_ENTRANCE
  INVENTORY_EXIT
}

enum InventoryStatus {
  DRAFT
  COMPLETED
  SIGNED_OWNER
  SIGNED_TENANT
  SIGNED_BOTH
}

enum RoomCondition {
  BON
  MAUVAIS
}

enum MissionStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MissionType {
  PROPERTY_VERIFICATION
  INVENTORY_REPORT
}

enum PropertyDocType {
  DIAGNOSTIC_DPE
  DIAGNOSTIC_AMIANTE
  DIAGNOSTIC_PLOMB
  DIAGNOSTIC_GAZ
  DIAGNOSTIC_ELECTRICITE
  DIAGNOSTIC_ERP
  ASSURANCE_HABITATION
  ASSURANCE_RC
  PERMIS_CONSTRUIRE
  ATTESTATION_CONFORMITE
  PLAN_BATIMENT
  AUTRE
}

enum MandatStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  TERMINATED
  EXPIRED
}

enum MandatType {
  GESTION_COMPLETE
  GESTION_LOCATION
  MANDAT_SIMPLE
}

// ─── User & Authentication ────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  phone           String?   @unique
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role      @default(LOCATAIRE)
  activeRole      Role      @default(LOCATAIRE)  // Currently active role (for role switching)
  avatarUrl       String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  // Trust Score verification fields
  gender          String?           // Genre (M/F)
  city            String?           // Ville
  address         String?           // Adresse
  birthDate       DateTime?         // Date de naissance (required for ONECI)
  nni             String?           // Numéro National d'Identification (ONECI)
  neofaceVerified   Boolean   @default(false) // Vérification biométrique KYC (NeoFace)
  neofaceVerifiedAt DateTime?                 // Date de vérification KYC
  kycDocumentId     String?                   // NeoFace document_id (temporary, during KYC flow)
  oneciVerified     Boolean   @default(false) // Vérification CNI ONECI
  oneciVerifiedAt DateTime?         // Date de vérification ONECI
  passwordUpdatedAt DateTime?       // Date de dernière modification du mot de passe
  // Owner-specific profile fields
  bio              String?           // Courte description / biographie
  companyName      String?           // Nom de l'entreprise (si applicable)
  showPhone        Boolean   @default(true)  // Visibilité du téléphone pour les candidats
  showEmail        Boolean   @default(false) // Visibilité de l'email pour les candidats
  twoFactorEnabled Boolean   @default(false) // Authentification à deux facteurs
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations — owned properties
  properties           Property[]
  // Relations — rental files (as tenant)
  rentalFiles          RentalFile[]
  // Relations — rental file reviews (as TC reviewer)
  reviewedRentalFiles  RentalFile[]       @relation("RentalFileReviewer")
  // Relations — owner files (as owner)
  ownerFiles            OwnerFile[]
  // Relations — owner file reviews (as TC reviewer)
  reviewedOwnerFiles    OwnerFile[]         @relation("OwnerFileReviewer")
  // Relations — ownership documents
  ownershipDocuments   OwnershipDocument[]
  // Relations — ownership doc reviews (as TC reviewer)
  reviewedOwnershipDocs OwnershipDocument[] @relation("OwnershipDocReviewer")
  // Relations — visit requests (as tenant)
  visitRequests        VisitRequest[]
  // Relations — leases (as tenant)
  leasesAsTenant       Lease[]            @relation("LeaseTenant")
  // Relations — leases (as owner)
  leasesAsOwner        Lease[]            @relation("LeaseOwner")
  // Relations — conversations
  conversations1       Conversation[]     @relation("ConversationParticipant1")
  conversations2       Conversation[]     @relation("ConversationParticipant2")
  // Relations — messages
  sentMessages         Message[]
  // Relations — ratings given
  ratingsGiven         Rating[]           @relation("RatingFrom")
  // Relations — ratings received
  ratingsReceived      Rating[]           @relation("RatingTo")
  // Relations — disputes reported
  disputesReported     Dispute[]
  // Relations — disputes resolved (as admin)
  disputesResolved     Dispute[]          @relation("DisputeResolver")
  // Relations — audit logs
  auditLogs            AuditLog[]
  // Relations — OTP codes
  otpCodes             OTPCode[]
  // Relations — validation SLA reviews
  validationSLAs       ValidationSLA[]
  // Relations — favorites
  favorites            Favorite[]
  // Relations — sessions
  sessions             Session[]
  // Relations — notification preferences
  notificationPreference NotificationPreference?
  // Relations — notifications
  notifications         Notification[]
  // Relations — payments (as tenant)
  payments              Payment[]
  // Relations — maintenance requests (as tenant)
  maintenanceRequests   MaintenanceRequest[]
  // Relations — inventory reports (as TC reviewer)
  inventoryReports     InventoryReport[]
  // Relations — verification agents created by this TC
  verificationAgents   VerificationAgent[]
  // Relations — missions as agent
  missions             Mission[]
  // Relations — disputes handled by this TC
  disputesHandled      Dispute[]          @relation("DisputeHandler")
  // Relations — connection logs
  connectionLogs       ConnectionLog[]
  // Relations — mandats as owner
  ownerMandats         Mandat[]           @relation("MandatOwner")
  // Relations — mandats as agency
  agencyMandats        Mandat[]           @relation("MandatAgency")
  // Relations — maintenance comments
  maintenanceComments  MaintenanceComment[]

  @@index([role])
  @@index([phone])
  @@index([email])
}

model OTPCode {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  code      String
  type      OTPType
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, type])
  @@index([email, type])
  @@index([code, phone])
  @@index([code, email])
}

// ─── Property (Annonce) ───────────────────────────────────────────────────────

model Property {
  id              String         @id @default(cuid())
  title           String         @default("")   // Empty for drafts
  description     String         @default("")   // Empty for drafts
  type            PropertyType   @default(STUDIO)
  status          PropertyStatus @default(DRAFT)
  rentalStatus    RentalStatus   @default(disponible)
  price           Float          @default(0)     // 0 for drafts
  currency        String         @default("FCFA")
  area            Float          @default(0)     // 0 for drafts
  bedrooms        Int?
  bathrooms       Int?
  address         String         @default("")   // Empty for drafts
  city            String         @default("")   // Empty for drafts
  commune         String?
  latitude        Float?
  longitude       Float?
  isFurnished     Boolean        @default(false)
  isVerified      Boolean        @default(false)
  hasParking      Boolean        @default(false)
  hasGarden       Boolean        @default(false)
  hasPool         Boolean        @default(false)
  hasGuardian     Boolean        @default(false)
  hasClimate      Boolean        @default(false)
  amenities       String         @default("[]")  // JSON array of amenity keys
  rentalTerms     String         @default("{}")  // JSON object with rental conditions
  hideOwnerName   Boolean        @default(false) // Owner can hide their name from property details
  virtualTourUrl  String?                          // URL for 3D virtual tour video (uploaded by owner)
  viewsCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  images           PropertyImage[]
  visitRequests    VisitRequest[]
  conversations    Conversation[]
  leases           Lease[]
  favorites        Favorite[]
  inventoryReports InventoryReport[]
  missions         Mission[]
  ratings          Rating[]
  documents        PropertyDocument[]
  mandats          Mandat[]

  @@index([status])
  @@index([city])
  @@index([type])
  @@index([price])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ─── Rental File (Dossier Locatif) ────────────────────────────────────────────

model RentalFile {
  id              String           @id @default(cuid())
  status          RentalFileStatus @default(DRAFT)
  tenantCategory  TenantCategory?
  monthlyIncome   Float?
  employer        String?
  employmentType  EmploymentType?
  guarantorName   String?
  guarantorPhone  String?
  guarantorRelation String?
  validUntil      DateTime?
  rejectionReason String?
  tcComment       String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenantId  String
  tenant    User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?  @relation("RentalFileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  documents RentalFileDocument[]
  leases    Lease[]

  @@index([status])
  @@index([tenantId])
}

model RentalFileDocument {
  id         String         @id @default(cuid())
  type       DocumentType
  url        String
  name       String
  status     DocumentStatus @default(PENDING)
  tcComment  String?
  createdAt  DateTime       @default(now())

  rentalFileId String
  rentalFile   RentalFile   @relation(fields: [rentalFileId], references: [id], onDelete: Cascade)

  @@index([rentalFileId])
  @@index([status])
}

// ─── Owner File (Dossier Propriétaire) ────────────────────────────────────────

model OwnerFile {
  id              String           @id @default(cuid())
  status          RentalFileStatus @default(DRAFT)
  monthlyIncome   Float?
  employer        String?
  employmentType  EmploymentType?
  guarantorName   String?
  guarantorPhone  String?
  guarantorRelation String?
  validUntil      DateTime?
  rejectionReason String?
  tcComment       String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  ownerId  String
  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?  @relation("OwnerFileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  documents OwnerFileDocument[]

  @@index([status])
  @@index([ownerId])
}

model OwnerFileDocument {
  id         String         @id @default(cuid())
  type       DocumentType
  url        String
  name       String
  status     DocumentStatus @default(PENDING)
  tcComment  String?
  createdAt  DateTime       @default(now())

  ownerFileId String
  ownerFile   OwnerFile   @relation(fields: [ownerFileId], references: [id], onDelete: Cascade)

  @@index([ownerFileId])
  @@index([status])
}

// ─── Property Ownership Validation ────────────────────────────────────────────

model OwnershipDocument {
  id         String            @id @default(cuid())
  type       OwnershipDocType
  url        String
  name       String
  status     DocumentStatus    @default(PENDING)
  tcComment  String?
  createdAt  DateTime          @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?  @relation("OwnershipDocReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
}

// ─── Visit Requests ───────────────────────────────────────────────────────────

model VisitRequest {
  id              String              @id @default(cuid())
  visitType       VisitType           @default(PHYSICAL)
  requestedDate   DateTime
  timeSlot        String
  status          VisitRequestStatus  @default(PENDING)
  counterDate     DateTime?
  counterTimeSlot String?
  ownerComment    String?
  tenantMessage   String?             // Message from tenant when requesting visit
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
}

// ─── Lease / Contract ─────────────────────────────────────────────────────────

model Lease {
  id                String      @id @default(cuid())
  status            LeaseStatus @default(DRAFT)
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Float
  charges           Float       @default(0)
  deposit           Float       @default(0)
  specialConditions String?
  ownerSignedAt     DateTime?
  ownerSignOtp      String?
  tenantSignedAt    DateTime?
  tenantSignOtp     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantId     String
  tenant       User       @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  ownerId      String
  owner        User       @relation("LeaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  rentalFileId String
  rentalFile   RentalFile @relation(fields: [rentalFileId], references: [id], onDelete: Cascade)

  ratings   Rating[]
  disputes  Dispute[]
  payments  Payment[]
  maintenanceRequests MaintenanceRequest[]
  inventoryReports   InventoryReport[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Conversation {
  id             String    @id @default(cuid())
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  participant1Id String
  participant1   User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)

  participant2Id String
  participant2   User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([participant1Id, participant2Id])
  @@index([propertyId])
  @@index([lastMessageAt])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
}

// ─── Favorites ────────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ─── Rating / Review ──────────────────────────────────────────────────────────

model Rating {
  id         String   @id @default(cuid())
  score      Int      // 1-5
  comment    String?
  reply      String?  // Response from the rated user
  repliedAt  DateTime?
  propertyId String?  // If rating is about a property (vs. person)
  createdAt  DateTime @default(now())

  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User     @relation("RatingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId   String
  toUser     User     @relation("RatingTo", fields: [toUserId], references: [id], onDelete: Cascade)

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([leaseId])
  @@index([toUserId])
  @@index([fromUserId])
  @@index([propertyId])
}

// ─── Dispute ──────────────────────────────────────────────────────────────────

model Dispute {
  id          String        @id @default(cuid())
  type        DisputeType
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  tcComment   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User    @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  resolvedById String?
  resolvedBy   User?    @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  handledById String?
  handledBy   User?    @relation("DisputeHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([leaseId])
  @@index([status])
  @@index([reportedById])
  @@index([handledById])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ─── Platform Settings ────────────────────────────────────────────────────────

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ─── TC Validation SLA ────────────────────────────────────────────────────────

model ValidationSLA {
  id           String                  @id @default(cuid())
  entityType   ValidationSLAEntityType
  entityId     String
  submittedAt  DateTime
  deadlineAt   DateTime
  completedAt  DateTime?
  isOverdue    Boolean                 @default(false)
  createdAt    DateTime                @default(now())

  reviewerId String?
  reviewer   User?     @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([isOverdue])
  @@index([deadlineAt])
  @@index([reviewerId])
}

// ─── Session Management ──────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// ─── Notification Preferences ──────────────────────────────────────────────

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  // Notification toggles — all default to true except promotions
  messages       Boolean @default(true)  // Nouveaux messages
  dossierUpdates Boolean @default(true)  // Mises à jour de dossier
  visitReminders Boolean @default(true)  // Demandes de visite / rappels
  paymentAlerts  Boolean @default(true)  // Alertes de paiement
  promotions     Boolean @default(false) // Promotions et offres spéciales
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  actionUrl String?                    // Optional link to related entity
  entityId  String?                    // ID of the related entity (lease, rental file, etc.)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?
  reference   String?                        // Payment reference number
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
}

// ─── Inventory Report (État des Lieux) ────────────────────────────────────────

model InventoryReport {
  id                  String         @id @default(cuid())
  type                InventoryType
  status              InventoryStatus @default(DRAFT)
  completedAt         DateTime?
  ownerSignedAt       DateTime?
  tenantSignedAt      DateTime?
  generalObservations String?
  totalKeys           Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  items InventoryReportItem[]
  mission Mission?

  @@index([propertyId])
  @@index([reviewerId])
  @@index([status])
}

model InventoryReportItem {
  id              String   @id @default(cuid())
  designation     String
  designationOrder Int
  kitchen         String?
  mainBathroom    String?
  otherBathroom   String?
  otherRoom1      String?
  otherRoom2      String?
  observations    String?

  reportId String
  report   InventoryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ─── Maintenance Requests ─────────────────────────────────────────────────────

model MaintenanceRequest {
  id          String             @id @default(cuid())
  title       String
  description String
  status      MaintenanceStatus  @default(PENDING)
  priority    MaintenancePriority @default(MEDIUM)
  images      String             @default("[]")  // JSON array of image URLs
  scheduledAt DateTime?                       // Scheduled intervention date
  resolution  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  comments MaintenanceComment[]

  @@index([leaseId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ─── Verification Agent (Agent de vérification) ────────────────────────────────

model VerificationAgent {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The TC who created this agent
  tcId String
  tc   User  @relation(fields: [tcId], references: [id], onDelete: Cascade)

  // Missions assigned to this agent
  missions Mission[]

  @@index([tcId])
  @@index([isActive])
}

// ─── Mission (Assignment for on-site verification) ────────────────────────────

model Mission {
  id          String        @id @default(cuid())
  type        MissionType
  status      MissionStatus @default(ASSIGNED)
  notes       String?
  reportUrl   String?                      // URL to the verification report/document
  scheduledAt DateTime                    // When the mission is scheduled
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // The property to verify
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // The agent assigned to this mission
  agentId String
  agent   VerificationAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // The TC who created this mission
  tcId String
  tc   User  @relation(fields: [tcId], references: [id], onDelete: Cascade)

  // Optional link to inventory report created during mission
  inventoryReportId String? @unique
  inventoryReport   InventoryReport? @relation(fields: [inventoryReportId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([agentId])
  @@index([tcId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Property Documents (US-P-050 to US-P-054) ──────────────────────────────

model PropertyDocument {
  id          String          @id @default(cuid())
  name        String
  type        PropertyDocType
  url         String
  description String?
  expiryDate  DateTime?                       // Date d'expiration (pour les diagnostics)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([type])
  @@index([expiryDate])
}

// ─── Mandat de Gestion (US-P-070 to US-P-075) ────────────────────────────────

model Mandat {
  id              String       @id @default(cuid())
  type            MandatType   @default(GESTION_LOCATION)
  status          MandatStatus @default(DRAFT)
  commissionRate  Float        @default(0)     // Pourcentage de commission (ex: 8.5)
  commissionType  String       @default("PERCENTAGE") // PERCENTAGE ou FIXED
  fixedCommission Float?                       // Montant fixe si commissionType = FIXED
  startDate       DateTime
  endDate         DateTime
  conditions      String?                      // Conditions particulières du mandat
  ownerSignedAt   DateTime?
  agencySignedAt  DateTime?
  terminatedAt    DateTime?
  terminationReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User    @relation("MandatOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  agencyId String
  agency   User    @relation("MandatAgency", fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([ownerId])
  @@index([agencyId])
  @@index([status])
}

// ─── Maintenance Comments (US-P-042) ────────────────────────────────────────

model MaintenanceComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([maintenanceRequestId])
  @@index([authorId])
  @@index([createdAt])
}

// ─── Connection Log (US-P-122) ──────────────────────────────────────────────

model ConnectionLog {
  id        String   @id @default(cuid())
  ipAddress String?
  userAgent String?
  device    String?                     // Type d'appareil détecté
  location  String?                     // Localisation approximative
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
