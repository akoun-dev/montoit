# ═══════════════════════════════════════════════════════════════════════
# Mon Toit CI — Variables d'environnement (.env.local)
#
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# NE JAMAIS commiter .env.local (contient des secrets).
# Inventaire détaillé : docs/ENVIRONNEMENT.md
#
# Conventions :
#   - les variables NEXT_PUBLIC_* sont exposées au navigateur → jamais de secret dedans ;
#   - les variables consommées par les Edge Functions (Deno.env.get) doivent aussi
#     être renseignées dans le Dashboard Supabase → Edge Functions → Secrets ;
#   - les valeurs par défaut présentes ici sont les valeurs par défaut du CODE
#     (non secrètes) : URLs publiques, identifiants partenaires affichés en clair
#     dans supabase/functions/_shared/*.
# ═══════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────
# SUPABASE — requis
# Dashboard Supabase → Project Settings → API
# ───────────────────────────────────────────────────────────────────────
# URL du projet Supabase (utilisée par le client navigateur ET le serveur)
NEXT_PUBLIC_SUPABASE_URL=<https://<ref-projet>.supabase.co>
# Clé publique "anon" (navigateur — protégée par les RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé-anon-publique>
# Clé service-role (SERVEUR UNIQUEMENT — contourne les RLS, accès total)
SUPABASE_SERVICE_ROLE_KEY=<clé-service-role-secrète>

# Pepper ajouté au hash des OTP (src/lib/otp-hash.ts). Optionnel mais
# FORTEMENT RECOMMANDÉ en production ; à défaut, la clé service-role sert
# de pepper. Chaîne aléatoire longue, stockée uniquement côté serveur.
OTP_HASH_PEPPER=
# Pepper des tokens d'accès des agents de terrain (TC-002/TC-003,
# src/lib/token-access.ts) : sert au hachage SHA-256 des liens magiques
# /m/{token} des missions (mission_access_tokens.token_hash) — le token
# n'est jamais stocké en clair. Sans valeur, la génération et la
# vérification des liens échouent (fail-closed) : les routes
# /api/tc/missions/[id]/access-link et /api/missions-token/* répondent 503.
# Générer une valeur : openssl rand -base64 32
MISSION_TOKEN_PEPPER=


# ───────────────────────────────────────────────────────────────────────
# APPLICATION — requis / optionnel
# ───────────────────────────────────────────────────────────────────────
# URL publique de l'application (callbacks de paiement, appels API internes).
# Requis en production, ex. https://mon-toit.ansut.ci
NEXT_PUBLIC_APP_URL=<https://mon-domaine.ci>

# URL de l'API utilisée par le bundle mobile Capacitor (src/lib/capacitor.ts).
# Optionnel — utile si l'app mobile pointe vers une API dédiée.
NEXT_PUBLIC_CAPACITOR_API_URL=

# Durée de vie des OTP en minutes (défaut du code : 5).
# Optionnel — consommée par les routes d'authentification SMS/email.
OTP_EXPIRY_MINUTES=5


# ───────────────────────────────────────────────────────────────────────
# PAIEMENTS — Intouch (Orange Money, MTN MoMo, Moov Money, Wave)
# Identifiants fournis par l'intégration Intouch (apidist.gutouch.net).
# Également requis dans les secrets des Edge Functions (payment-initiate,
# payment-callback, payment-transfer, generate-monthly-payments).
# ───────────────────────────────────────────────────────────────────────
# Point d'entrée de l'API distributrice Intouch (défaut du code ci-dessous)
INTOUCH_BASE_URL=https://apidist.gutouch.net/apidist/sec/
# Identifiants du compte marchand Intouch
INTOUCH_USERNAME=<identifiant-compte-intouch>
INTOUCH_PASSWORD=<mot-de-passe-compte-intouch>
# Identifiants partenaires (défauts du code — fournis par Intouch)
INTOUCH_PARTNER_ID=CI300373
INTOUCH_LOGIN_API=07084598370
INTOUCH_API_PASSWORD=<mot-de-passe-api-intouch>

# Callback Intouch vers la plateforme (webhook de confirmation de paiement)
INTOUCH_CALLBACK_URL=https://mon-toit.ci/api/payments/callback
# Secret partagé du callback côté Intouch (signature des retours)
INTOUCH_CALLBACK_SECRET=<secret-hmac-callback-intouch>

# Paiement immédiat/anticipé (défaut du code ci-dessous)
INTOUCH_PAIEMENT_IMMEDIAT_URL=https://businessapi.gutouch.com/paiements-immediats
# URLs de retour/cancel opérateur Wave
INTOUCH_WAVE_RETURN_URL=<https://mon-domaine.ci/paiements/retour>
INTOUCH_WAVE_CANCEL_URL=<https://mon-domaine.ci/paiements/annule>

# URL publique de l'app vue par Intouch (fallback des URLs de retour)
INTOUCH_PUBLIC_APP_URL=<https://mon-domaine.ci>

# Secret HMAC (SHA-256) de vérification du webhook /api/payments/callback
# (header x-webhook-signature). OBLIGATOIRE en production : sans ce secret,
# le webhook de paiement n'est pas authentifié. À définir aussi côté
# orchestrateur qui émet le webhook.
PAYMENT_CALLBACK_SECRET=<secret-hmac-webhook-paiements>

# Plafond maximal d'un transfert de fonds en XOF (fonctions de transfert
# Intouch). Optionnel — contrôle serveur anti-abus ; laisser vide pour
# désactiver le plafond.
MAX_TRANSFER_AMOUNT_XOF=

# Secret porté par le scheduler des Edge Functions planifiées (rappels,
# expirations, paiements mensuels, impayés) : l'appelant doit envoyer
# « Authorization: Bearer <CRON_SECRET> ».
# À définir aussi dans les secrets des Edge Functions. REQUIS EN PRODUCTION :
# sans ce secret, les fonctions planifiées ne sont pas authentifiées.
CRON_SECRET=<secret-bearer-taches-planifiees>


# ───────────────────────────────────────────────────────────────────────
# SIGNATURE ÉLECTRONIQUE — CRYPTONEO / ANSUT
# Clés d'application fournies par la plateforme CRYPTONEO (signature.ansut.ci).
# Également requis dans les secrets des Edge Functions (signature-*,
# *-certificate).
# ───────────────────────────────────────────────────────────────────────
# URL de la plateforme de signature (défaut du code : signature.ansut.ci)
CRYPTONEO_API_URL=https://signature.ansut.ci
# Clé d'application CRYPTONEO
CRYPTONEO_APP_KEY=<app-key-cryptoneo>
# Secret d'application CRYPTONEO
CRYPTONEO_APP_SECRET=<app-secret-cryptoneo>


# ───────────────────────────────────────────────────────────────────────
# KYC — RNPP Connect / ONECI (identité : NNI, empreinte)
# Clés fournies par le service RNPP Connect.
# Également requis dans les secrets des Edge Functions (oneci-*).
# ───────────────────────────────────────────────────────────────────────
# Base de l'API RNPP Connect (défaut du code ci-dessous)
RNPP_API_BASE=https://kyc.rnpp-connect.ci/api
# Clé d'API RNPP Connect
RNPP_API_KEY=<cle-api-rnpp>


# ───────────────────────────────────────────────────────────────────────
# KYC — NeoFace / AIneo (reconnaissance faciale)
# Consommé par l'Edge Function kyc-face-auth.
# ───────────────────────────────────────────────────────────────────────
# Base de l'API NeoFace (défaut du code : https://neoface.aineo.ai/api/v2)
NEOFACE_API_BASE=https://neoface.aineo.ai
# Bearer token NeoFace (obligatoire pour l'authentification faciale)
NEOFACE_BEARER_TOKEN=<bearer-token-neoface>


# ───────────────────────────────────────────────────────────────────────
# MESSAGERIE — ANSUT Hub (SMS + email transactionnels, OTP)
# Compte fourni par la passerelle ANSUT.
# Utilisé côté Next.js (src/lib/ansut-messaging.ts) ET dans les Edge
# Functions (_shared/ansut-messaging.ts) → renseigner dans les deux endroits.
# ───────────────────────────────────────────────────────────────────────
# Base de la passerelle ANSUT (défaut du code ci-dessous)
ANSUT_API_BASE_URL=https://ansuthub.westeurope.cloudapp.azure.com/gateway/api
# Identifiants du compte ANSUT
ANSUT_API_USERNAME=<identifiant-ansut>
ANSUT_API_PASSWORD=<mot-de-passe-ansut>
# Nom d'expéditeur SMS (défaut du code : ANSUT)
ANSUT_SMS_SENDER=ANSUT


# ───────────────────────────────────────────────────────────────────────
# ASSISTANT — Chatbot SUTA (Azure OpenAI) — SERVEUR UNIQUEMENT
# Ressource Azure OpenAI fournie par la DTDI. Ne JAMAIS exposer la clé
# côté navigateur (consommée par /api/suta).
# ───────────────────────────────────────────────────────────────────────
# Endpoint de la ressource Azure OpenAI
AZURE_OPENAI_ENDPOINT=<https://<nom-ressource>.openai.azure.com/>
# Clé d'API Azure OpenAI
AZURE_OPENAI_API_KEY=<cle-api-azure-openai>
# Nom du déploiement du modèle (défaut du code ci-dessous)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-luna
# Version de l'API Azure OpenAI (défaut du code ci-dessous)
AZURE_OPENAI_API_VERSION=2025-04-01-preview
