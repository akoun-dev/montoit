<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr_FR</string>
	<key>CFBundleDisplayName</key>
        <string>Mon Toit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ── Permissions ──────────────────────────────────────── -->

	<!-- Localisation (géolocalisation des biens) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mon Toit utilise votre position pour afficher les biens immobiliers autour de vous.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Mon Toit utilise votre position pour afficher les biens immobiliers autour de vous.</string>

	<!-- Caméra (KYC NeoFace, photo de profil) -->
	<key>NSCameraUsageDescription</key>
	<string>Mon Toit utilise la caméra pour la vérification d&apos;identité et la prise de photo de profil.</string>

	<!-- Micro (vidéo KYC, getUserMedia WebRTC) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Mon Toit a besoin d&apos;accéder à votre micro lors de la vérification d&apos;identité par vidéo.</string>

	<!-- Face ID (KYC selfie sécurisé) -->
	<key>NSFaceIDUsageDescription</key>
	<string>Mon Toit utilise Face ID lors de la vérification d&apos;identité KYC.</string>

	<!-- Galerie photos (upload photos de biens, documents) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mon Toit accède à vos photos pour vous permettre de télécharger des images de biens et des documents.</string>

	<!-- Enregistrement dans la galerie -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Mon Toit peut enregistrer des photos dans votre bibliothèque.</string>

	<!-- Notifications push (mode background) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>

	<!-- App Transport Security : dev local + domaines de production -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>mon-toit.ansut.ci</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			<key>neoface.aineo.ai</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			<key>ansut.ci</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			<key>aineo.ai</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
		</dict>
	</dict>

	<!-- Schémes externes (équivalent <queries> Android) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>maps</string>
		<string>https</string>
		<string>http</string>
	</array>

	<!-- ── Fin permissions ──────────────────────────────────── -->

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Le style de la status bar est géré dynamiquement par MainViewController
	     (preferredStatusBarStyle) selon le thème courant (clair/sombre) — adapté
	     à la fois au mode système iOS et au thème de la page web (classe `dark`). -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
